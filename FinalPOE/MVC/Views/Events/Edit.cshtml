@model RaceDayMVC.Models.EventViewModel

@{

    ViewData["Title"] = "Edit Event";

}

<div class="container mt-4 mb-5">

    <div class="row justify-content-center">

        <div class="col-lg-9">

            <div class="card p-4">

                <div class="mb-4">

                    <h2>🏁 Edit Racing Event</h2>

                    <p class="text-muted">

                        Update the event information below.

                    </p>

                </div>

                <form asp-controller="Events"
                      asp-action="Edit"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="All"
                         class="alert alert-danger"
                         role="alert"></div>

                    <input type="hidden" asp-for="Event_ID" />

                    <h4>Event Information</h4>

                    <hr />

                    <div class="mb-3">

                        <label asp-for="Event_ID" class="form-label">Event ID</label>

                        <input asp-for="Event_ID" class="form-control" readonly />

                    </div>

                    <div class="mb-3">

                        <label asp-for="Event_Name" class="form-label">Event Name</label>

                        <input asp-for="Event_Name"
                               class="form-control"
                               maxlength="100"
                               required />

                        <span asp-validation-for="Event_Name" class="text-danger"></span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="Event_Description" class="form-label">

                            Event Description

                        </label>

                        <textarea asp-for="Event_Description"
                                  class="form-control"
                                  rows="4"
                                  maxlength="500"></textarea>

                        <span asp-validation-for="Event_Description" class="text-danger"></span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="Event_Date" class="form-label">Event Date</label>

                        <input asp-for="Event_Date"
                               type="date"
                               class="form-control"
                               required />

                        <span asp-validation-for="Event_Date" class="text-danger"></span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="Event_Location" class="form-label">

                            Event Location

                        </label>

                        <input asp-for="Event_Location"
                               class="form-control"
                               maxlength="100" />

                        <span asp-validation-for="Event_Location" class="text-danger"></span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="Event_Distance" class="form-label">

                            Event Distance (km)

                        </label>

                        <input asp-for="Event_Distance"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control" />

                        <span asp-validation-for="Event_Distance" class="text-danger"></span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="Event_Type" class="form-label">Event Type</label>

                        <select asp-for="Event_Type" class="form-select">

                            <option value="">Select Event Type</option>

                            <option value="Road Race">Road Race</option>

                            <option value="Marathon">Marathon</option>

                            <option value="Fun Run">Fun Run</option>

                            <option value="Trail Run">Trail Run</option>

                            <option value="Cycling">Cycling</option>

                        </select>

                        <span asp-validation-for="Event_Type" class="text-danger"></span>

                    </div>

                    <h4 class="mt-4">Event Classification</h4>

                    <hr />

                    <div class="mb-3">

                        <label asp-for="CategoryID" class="form-label">Category ID</label>

                        <input asp-for="CategoryID"
                               class="form-control"
                               required />

                        <span asp-validation-for="CategoryID" class="text-danger"></span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="EventOrganizerID" class="form-label">

                            Organiser ID

                        </label>

                        <input asp-for="EventOrganizerID"
                               class="form-control"
                               required />

                        <span asp-validation-for="EventOrganizerID" class="text-danger"></span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="VenueID" class="form-label">Venue ID</label>

                        <input asp-for="VenueID"
                               class="form-control"
                               required />

                        <span asp-validation-for="VenueID" class="text-danger"></span>

                    </div>

                    <hr />

                    <div class="d-flex flex-wrap gap-2">

                        <button type="submit" class="btn btn-raceday">

                            Save Changes

                        </button>

                        <a asp-controller="Organiser"
                           asp-action="Index"
                           class="btn btn-secondary">

                            Cancel

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}