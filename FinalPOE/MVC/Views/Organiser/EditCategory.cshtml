@model RaceDayMVC.Models.CategoryViewModel

@{

    ViewData["Title"] = "Edit Category";

}

<div class="container mt-4">

    <h2>Edit Event Category</h2>

    <p>Update the category information below.</p>

    <form asp-controller="Organiser"
          asp-action="EditCategory"
          asp-route-id="@Model.Category_ID"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="mb-3">

            <label asp-for="Category_ID" class="form-label">

                Category ID

            </label>

            <input asp-for="Category_ID"
                   class="form-control"
                   readonly />

        </div>

        <div class="mb-3">

            <label asp-for="Event_Category_Name" class="form-label">

                Category Name

            </label>

            <input asp-for="Event_Category_Name"
                   class="form-control" />

        </div>

        <div class="mb-3">

            <label asp-for="Event_Category_Type" class="form-label">

                Category Type

            </label>

            <input asp-for="Event_Category_Type"
                   class="form-control" />

        </div>

        <button type="submit" class="btn btn-primary">

            Save Changes

        </button>

        <a asp-controller="Organiser"
           asp-action="Categories"
           class="btn btn-secondary">

            Cancel

        </a>

    </form>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
