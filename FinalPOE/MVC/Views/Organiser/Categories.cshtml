@model List<RaceDayMVC.Models.CategoryViewModel>

@{

    ViewData["Title"] = "Manage Categories";

}

<div class="container mt-4">

    <h2>Manage Event Categories</h2>

    <p>View and manage categories for RaceDay events.</p>

    @if (TempData["Success"] != null)

    {

        <div class="alert alert-success">

            @TempData["Success"]

        </div>

    }

    @if (TempData["Error"] != null)

    {

        <div class="alert alert-danger">

            @TempData["Error"]

        </div>

    }

    @if (ViewBag.Error != null)

    {

        <div class="alert alert-danger">

            @ViewBag.Error

        </div>

    }

    <a asp-controller="Organiser"
       asp-action="CreateCategory"
       class="btn btn-primary mb-3">

        + Create New Category

    </a>

    <table class="table table-bordered table-striped">

        <thead>

            <tr>

                <th>Category ID</th>

                <th>Category Name</th>

                <th>Category Type</th>

                <th>Actions</th>

            </tr>

        </thead>

        <tbody>

            @if (Model != null && Model.Any())

            {

                foreach (var category in Model)

                {

                    <tr>

                        <td>@category.Category_ID</td>

                        <td>@category.Event_Category_Name</td>

                        <td>@category.Event_Category_Type</td>

                        <td>

                            <a asp-controller="Organiser"
                               asp-action="EditCategory"
                               asp-route-id="@category.Category_ID"
                               class="btn btn-warning btn-sm">

                                Edit

                            </a>

                            <form asp-controller="Organiser"
                                  asp-action="DeleteCategory"
                                  asp-route-id="@category.Category_ID"
                                  method="post"
                                  style="display:inline">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-danger btn-sm"
                                        onclick="return confirm('Are you sure you want to delete this category?');">

                                    Delete

                                </button>

                            </form>

                        </td>

                    </tr>

                }

            }

            else

            {

                <tr>

                    <td colspan="4">No event categories found.</td>

                </tr>

            }

        </tbody>

    </table>

    <a asp-controller="Organiser"
       asp-action="Index"
       class="btn btn-secondary">

        Back to Dashboard

    </a>

</div>