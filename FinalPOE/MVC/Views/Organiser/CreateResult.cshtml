@model RaceDayMVC.Models.RaceResultViewModel

@{

    ViewData["Title"] = "Add Race Result";

}

<div class="container mt-4">

    <h2>Add Race Result</h2>

    <form asp-controller="Organiser" asp-action="CreateResult" method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="mb-3">

            <label asp-for="RaceResult_ID" class="form-label">Result ID</label>

            <input asp-for="RaceResult_ID" class="form-control"
                   placeholder="Example: RES001" />

            <span asp-validation-for="RaceResult_ID" class="text-danger"></span>

        </div>

        <div class="mb-3">

            <label asp-for="Registration_ID" class="form-label">Participant Registration</label>

            <select asp-for="Registration_ID" class="form-select">

                <option value="">-- Select Registration --</option>

                @if (ViewBag.Enrolments != null)

                {

                    foreach (var enrolment in ViewBag.Enrolments)

                    {

                        <option value="@enrolment.Registration_ID">

                            @enrolment.Registration_ID -

                            @enrolment.Participant_Name

                            @enrolment.Participant_Surname

                            (Event: @enrolment.EventID)

                        </option>

                    }

                }

            </select>

            <span asp-validation-for="Registration_ID" class="text-danger"></span>

        </div>

        <div class="mb-3">

            <label asp-for="Finishing_Position" class="form-label">Finishing Position</label>

            <input asp-for="Finishing_Position" type="number"
                   min="1" class="form-control" />

            <span asp-validation-for="Finishing_Position" class="text-danger"></span>

        </div>

        <div class="mb-3">

            <label asp-for="Finish_Time" class="form-label">Finish Time</label>

            <input asp-for="Finish_Time" type="time" step="1"
                   class="form-control" />

            <span asp-validation-for="Finish_Time" class="text-danger"></span>

        </div>

        <button type="submit" class="btn btn-success">

            Save Result

        </button>

        <a asp-controller="Organiser" asp-action="Results"
           class="btn btn-secondary">

            Cancel

        </a>

    </form>

</div>
