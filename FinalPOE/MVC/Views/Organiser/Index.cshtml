@model List<RaceDayMVC.Models.EventViewModel>

@{

    ViewData["Title"] = "Organiser Dashboard";

}

<div class="container mt-4">

    <h2>Organiser Dashboard</h2>

    @if (TempData["Success"] != null)

    {

        <div class="alert alert-success">

            @TempData["Success"]

        </div>

    }

    @if (TempData["Error"] != null)

    {

        <div class="alert alert-danger">

            @TempData["Error"]

        </div>

    }

    @if (ViewBag.Error != null)

    {

        <div class="alert alert-danger">

            @ViewBag.Error

        </div>

    }

    <hr />

   

    <div class="row mb-4">

        <div class="col-md-4">

            <div class="card bg-primary text-white">

                <div class="card-body">

                    <h5>Total Events</h5>

                    <h2>@Model.Count</h2>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card bg-success text-white">

                <div class="card-body">

                    <h5>Total Enrolments</h5>

                    <h2>@Model.Sum(e => e.TotalEnrolments)</h2>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card bg-info text-white">

                <div class="card-body">

                    <h5>Upcoming Events</h5>

                    <h2>

                        @(((List<RaceDayMVC.Models.EventViewModel>)ViewBag.UpcomingEvents).Count)

                    </h2>

                </div>

            </div>

        </div>

    </div>

    <!-- Management buttons -->

    <h3>Management</h3>

    <a asp-controller="Events"
       asp-action="Create"
       class="btn btn-primary mb-3">

        + Create New Event

    </a>

    <a asp-controller="Organiser"
       asp-action="Categories"
       class="btn btn-success mb-3">

        Manage Categories

    </a>

    <a asp-controller="Organiser"
       asp-action="CreateCategory"
       class="btn btn-info mb-3">

        + Create New Category

    </a>

    <a asp-controller="Organiser"
       asp-action="Results"
       class="btn btn-warning mb-3">

        Manage Results

    </a>

    <!-- All events -->

    <h3>Manage Events</h3>

    <div class="table-responsive">

        <table class="table table-bordered table-striped">

            <thead class="table-dark">

                <tr>

                    <th>Event ID</th>

                    <th>Banner</th>

                    <th>Location</th>

                    <th>Date</th>

                    <th>Category</th>

                    <th>Total Enrolments</th>

                    <th>Actions</th>

                </tr>

            </thead>

            <tbody>

                @if (Model != null && Model.Any())

                {

                    @foreach (var item in Model)

                    {

                        <tr>

                            <td>@item.Event_ID</td>

                            <td>

                                <img src="@Url.Content("https://localhost:7211/api/Images/event-banner/" + Uri.EscapeDataString(item.Event_ID))"
                                     alt="Event banner"
                                     style="width:120px; height:70px; object-fit:cover;"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='inline';" />

                                <span class="text-muted"
                                      style="display:none;">

                                    No banner

                                </span>

                            </td>

                            <td>@item.Event_Location</td>

                            <td>@item.Event_Date.ToString("dd MMM yyyy")</td>

                            <td>@item.CategoryID</td>

                            <td>@item.TotalEnrolments</td>

                            <td>

                                <a asp-controller="Organiser"
                                   asp-action="Enrolments"
                                   asp-route-eventId="@item.Event_ID"
                                   class="btn btn-info btn-sm">

                                    View Enrolments

                                </a>

                                <a asp-controller="Events"
                                   asp-action="Edit"
                                   asp-route-id="@item.Event_ID"
                                   class="btn btn-warning btn-sm">

                                    Edit

                                </a>

                                <form asp-controller="Events"
                                      asp-action="Delete"
                                      asp-route-id="@item.Event_ID"
                                      method="post"
                                      style="display:inline;"
                                      onsubmit="return confirm('Are you sure you want to delete this event?');">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-danger btn-sm">

                                        Delete

                                    </button>

                                </form>

                            </td>

                        </tr>

                    }

                }

                else

                {

                    <tr>

                        <td colspan="7" class="text-center">

                            No events found.

                        </td>

                    </tr>

                }

            </tbody>

        </table>

    </div>

    

    <h3 class="mt-4">Upcoming Events</h3>

    @{

        var upcomingEvents =

            ViewBag.UpcomingEvents as List<RaceDayMVC.Models.EventViewModel>;

    }

    @if (upcomingEvents != null && upcomingEvents.Any())

    {

        <ul class="list-group">

            @foreach (var item in upcomingEvents)

            {

                <li class="list-group-item">

                    <strong>@item.Event_ID</strong>

                    - @item.Event_Location

                    - @item.Event_Date.ToString("dd MMM yyyy")

                </li>

            }

        </ul>

    }

    else

    {

        <p>No upcoming events.</p>

    }

</div>